{
        "compilerOptions": {
                "target": "ES2022",
                "module": "commonjs",
                "moduleResolution": "node",
                "esModuleInterop": true,
                "strict": true,
                "skipLibCheck": true,
                "outDir": "./out-test",
                "rootDir": ".",
                "types": ["mocha", "node"],
                "resolveJsonModule": true,
                "declaration": false,
                "sourceMap": true,
                "allowJs": false,
                "noEmit": false,
                "ignoreDeprecations": "5.0"
        },
        "include": [
                "./*.ts",
                "./agent/**/*.ts",
                "./services/**/*.ts",
                "./_stubs/**/*.ts",
                "./ui/**/*.ts",
                "./security/**/*.ts",
                "./tools/**/*.ts",
                "./accessibility/**/*.ts",
                "./build/**/*.ts",
                "./config/**/*.ts",
                "./diff/**/*.ts",
                "./e2e/**/*.ts",
                "./ipc/**/*.ts",
                "./mcp/**/*.ts",
                "./memory/**/*.ts",
                "./notification/**/*.ts",
                "./performance/**/*.ts",
                "./project/**/*.ts",
                "./service/**/*.ts",
                "./unit/**/*.ts"
        ]
}
